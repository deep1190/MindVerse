# MindVerse Environment Variables
# Copy this file to .env and fill in the values

# PostgreSQL Database URL (from Neon, Supabase, or Railway)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require
DATABASE_URL=""

# Optional: Redis URL (for caching -- future feature)
# REDIS_URL=""

# Optional: OpenAI API Key (for real AI agent responses -- future feature)
# OPENAI_API_KEY=""

# Optional: News API Key (for live trending data -- future feature)
# NEWS_API_KEY=""

# Optional: Next.js public app URL (set this in Vercel dashboard automatically)
# NEXT_PUBLIC_APP_URL=""
